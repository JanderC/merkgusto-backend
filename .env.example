# ═══════════════ MERKGUSTO GYM · Backend ═══════════════
PORT=5050
NODE_ENV=development
TZ=America/Caracas
# Orígenes del frontend permitidos (coma). En producción el backend sirve la web.
CORS_ORIGIN=http://localhost:5173
ABRIR_NAVEGADOR=false

# ── Base de datos PostgreSQL (se crea sola al arrancar) ──
# DATABASE_URL=postgres://user:pass@host:5432/merkgusto_gym   (tiene prioridad)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merkgusto_gym
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# ── Seguridad ──
# Vacío = se genera solo y se guarda en STORAGE_DIR/secretos.json
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Dueño inicial (solo se crea la primera vez)
DUENO_NOMBRE=Dueño Merkgusto
DUENO_USUARIO=dueno
DUENO_PASSWORD=Merkgusto2026*

GYM_NOMBRE=MERKGUSTO GYM

# ── Multimoneda ──
# Moneda en que se suman reportes y finanzas (USD, VES o COP). Fíjala antes de empezar a vender.
MONEDA_REFERENCIA=COP

# ── Carpeta de datos (archivos + sesión de WhatsApp). Vacío = backend/storage ──
# En Railway: crea un Volume montado en /data y pon STORAGE_DIR=/data
STORAGE_DIR=

# ── Archivos (fotos de marcaciones, soportes, comprobantes) ──
# Se guardan en el disco de este servidor, sin servicios externos.
# Vacío = STORAGE_DIR/archivos. Inclúyela en los respaldos.
ARCHIVOS_DIR=

# ── WhatsApp ──
WHATSAPP_ENABLED=true
# Código de país para normalizar números locales (0414… → 58414…)
WHATSAPP_CODIGO_PAIS=58
# IA para responder clientes (gratis en https://console.groq.com/keys). Vacío = respuestas por palabras clave
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Control de acceso facial Hikvision DS-K1T344 (MinMoe) ──
# mock     → lector simulado (desarrollo, sin hardware)
# isapi    → lector real por ISAPI con HTTP Digest
# disabled → sin control de acceso
BIOMETRIC_MODE=mock
# servidor = el lector pregunta y el sistema decide si abre (verificación remota) · lector = decide el lector
BIOMETRIC_DECISION=servidor
HIKVISION_HOST=http://192.168.1.64
HIKVISION_USER=admin
HIKVISION_PASSWORD=
HIKVISION_DOOR_NO=1
HIKVISION_FDID=1
# Timeouts estrictos (ms). El alta de rostro tarda más porque el lector lo modela.
HIKVISION_TIMEOUT_MS=5000
HIKVISION_FACE_TIMEOUT_MS=15000
HIKVISION_RETRIES=2
# Circuit breaker: tras N fallos de red seguidos, deja de llamar al lector durante el enfriamiento
HIKVISION_BREAKER_THRESHOLD=4
HIKVISION_BREAKER_COOLDOWN_MS=30000

# Webhook (Listening Host): el lector hace POST a <BIOMETRIC_PUBLIC_URL>/api/biometric/events/<BIOMETRIC_WEBHOOK_TOKEN>
# Vacío = se genera solo (no hace falta mientras no haya lector)
BIOMETRIC_WEBHOOK_TOKEN=
# URL de ESTE servidor vista desde el lector (IP de la PC en la LAN del gimnasio)
BIOMETRIC_PUBLIC_URL=http://192.168.1.10:5050
# Redes/IPs desde las que se aceptan eventos (CIDR, coma). Vacío = localhost + redes privadas
BIOMETRIC_ALLOWED_IPS=
# MAC del lector (etiqueta del equipo). Si se llena, se rechazan eventos de otros equipos
BIOMETRIC_DEVICE_MACS=
BIOMETRIC_DEVICE_IPS=
# Simulador
BIOMETRIC_MOCK_LATENCY_MS=250
BIOMETRIC_MOCK_FAILURE_RATE=0
